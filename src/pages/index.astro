---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { curatedPublicProjects, privateCases } from '../data/projects'

const githubProfile = 'https://github.com/Pericles-cmyk'
const whatsapp = 'https://wa.me/5581994094491?text=Olá%20PericlesDev!%20Quero%20conversar%20sobre%20um%20projeto.'

const capabilities = [
  ['Sistemas de gestão', 'Produtos para operação: pedidos, estoque, pagamentos, usuários, relatórios e rotinas internas.'],
  ['Agendamento', 'Experiências de reserva e gestão de horários adaptadas ao fluxo de cada negócio.'],
  ['Sites e presença digital', 'Sites institucionais e páginas comerciais com foco em clareza, confiança e conversão.'],
  ['Aplicações locais', 'Soluções para rede local, SQLite, Node.js, impressão e instalação em ambiente Windows.'],
]

const process = [
  ['01', 'Entender', 'Mapeio operação, usuário e objetivo antes de escolher a tecnologia.'],
  ['02', 'Desenhar', 'Organizo fluxos e interface para reduzir atrito no uso diário.'],
  ['03', 'Construir', 'Desenvolvo frontend, backend, dados e integrações necessárias.'],
  ['04', 'Implantar', 'Configuro ambiente, domínio, infraestrutura e entrega da solução.'],
]
---
<BaseLayout>
  <Header />

  <main>
    <section class="portfolio-hero" id="inicio">
      <div class="portfolio-hero__copy">
        <span class="portfolio-kicker">PERICLESDEV / DESENVOLVIMENTO DE SOFTWARE</span>
        <h1>Planejo, desenvolvo e transformo <em>necessidades reais</em> em software.</h1>
        <p>
          Sistemas de gestão, plataformas de agendamento e experiências web construídas
          do fluxo de uso à infraestrutura.
        </p>

        <div class="portfolio-hero__actions">
          <a class="btn btn--primary" href="#projetos">Conhecer projetos</a>
          <a class="portfolio-link" href={whatsapp} target="_blank" rel="noreferrer">Falar sobre um projeto ↗</a>
        </div>
      </div>

      <aside class="portfolio-hero__side" aria-label="Áreas de atuação">
        <span class="portfolio-hero__monogram">PD</span>
        <div class="portfolio-hero__disciplines">
          <span>01 <strong>Produto & UX</strong></span>
          <span>02 <strong>Desenvolvimento</strong></span>
          <span>03 <strong>Dados & infraestrutura</strong></span>
        </div>
      </aside>
    </section>

    <section class="portfolio-section portfolio-projects" id="projetos">
      <header class="portfolio-section__head">
        <div>
          <span class="portfolio-kicker">TRABALHOS SELECIONADOS</span>
          <h2>Projetos construídos para contextos diferentes.</h2>
        </div>
        <p>
          Cada case parte de uma necessidade específica. A interface, a arquitetura e a
          entrega mudam de acordo com a operação do cliente.
        </p>
      </header>

      <div class="project-grid project-grid--private">
        {privateCases.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>

    <section class="portfolio-section portfolio-capabilities" id="solucoes">
      <header class="portfolio-section__head portfolio-section__head--compact">
        <div>
          <span class="portfolio-kicker">O QUE EU DESENVOLVO</span>
          <h2>Soluções digitais sem complexidade desnecessária.</h2>
        </div>
      </header>

      <div class="capability-list">
        {capabilities.map(([title, description], index) => (
          <article class="capability-item">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="portfolio-section portfolio-process" id="processo">
      <header class="portfolio-section__head portfolio-section__head--compact">
        <div>
          <span class="portfolio-kicker">PROCESSO</span>
          <h2>Do problema à implantação.</h2>
        </div>
      </header>

      <div class="process-list">
        {process.map(([number, title, description]) => (
          <article class="process-item">
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>

      <div class="stack-line" aria-label="Tecnologias">
        {['Astro', 'TypeScript', 'React', 'Node.js', 'Supabase', 'PostgreSQL', 'SQLite', 'Cloudflare']
          .map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section class="portfolio-section public-work">
      <header class="public-work__head">
        <div>
          <span class="portfolio-kicker">CÓDIGO PÚBLICO</span>
          <h2>Projetos no GitHub.</h2>
        </div>
        <a class="portfolio-link" href={githubProfile} target="_blank" rel="noreferrer">Ver perfil completo ↗</a>
      </header>

      <div class="public-project-list" data-github-grid>
        {curatedPublicProjects.map((project) => (
          <article class="public-project-row" data-repo-url={project.repoUrl || ''}>
            <div>
              <span>{project.category}</span>
              <h3>{project.title}</h3>
            </div>
            <p>{project.description}</p>
            <div class="public-project-row__meta">
              <span>{project.stack.slice(0, 3).join(' · ')}</span>
              <a href={project.repoUrl} target="_blank" rel="noreferrer" aria-label={`Abrir ${project.title} no GitHub`}>↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="portfolio-section portfolio-about" id="sobre">
      <span class="portfolio-kicker">PERICLESDEV</span>
      <div class="portfolio-about__grid">
        <h2>Tecnologia aplicada ao que o negócio realmente precisa.</h2>
        <div>
          <p>
            Trabalho conectando interface, regras de negócio, dados e infraestrutura para
            transformar processos em produtos digitais utilizáveis no dia a dia.
          </p>
          <p>
            A tecnologia entra como ferramenta. A prioridade é uma solução clara,
            sustentável e adequada ao contexto de quem vai usar.
          </p>
        </div>
      </div>
    </section>

    <section class="portfolio-section portfolio-contact" id="contato">
      <div>
        <span class="portfolio-kicker">NOVO PROJETO</span>
        <h2>Tem uma operação que pode funcionar melhor?</h2>
        <p>Podemos conversar sobre o problema antes de falar em tecnologia.</p>
      </div>
      <a class="btn btn--primary" href={whatsapp} target="_blank" rel="noreferrer">Conversar no WhatsApp</a>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  interface GithubProject {
    id: number
    name: string
    description: string | null
    html_url: string
    homepage: string | null
    language: string | null
    topics: string[]
  }

  const grid = document.querySelector<HTMLElement>('[data-github-grid]')

  function titleFromRepo(name: string) {
    return name
      .replace(/[-_]/g, ' ')
      .replace(/\b\w/g, (letter) => letter.toUpperCase())
  }

  function addDynamicProject(repo: GithubProject) {
    if (!grid) return

    const existing = new Set(
      Array.from(grid.querySelectorAll<HTMLElement>('[data-repo-url]'))
        .map((element) => element.dataset.repoUrl)
        .filter(Boolean),
    )
    if (existing.has(repo.html_url)) return

    const row = document.createElement('article')
    row.className = 'public-project-row'
    row.dataset.repoUrl = repo.html_url

    const heading = document.createElement('div')
    const category = document.createElement('span')
    category.textContent = repo.topics.find((topic) => topic !== 'portfolio') || 'Open source'
    const title = document.createElement('h3')
    title.textContent = titleFromRepo(repo.name)
    heading.append(category, title)

    const description = document.createElement('p')
    description.textContent = repo.description || 'Projeto público desenvolvido pela PericlesDev.'

    const meta = document.createElement('div')
    meta.className = 'public-project-row__meta'

    const stack = document.createElement('span')
    const technologies = [
      repo.language,
      ...repo.topics.filter((topic) => topic !== 'portfolio').slice(0, 2),
    ].filter(Boolean)
    stack.textContent = technologies.join(' · ')

    const link = document.createElement('a')
    link.href = repo.html_url
    link.target = '_blank'
    link.rel = 'noreferrer'
    link.textContent = '↗'
    link.setAttribute('aria-label', `Abrir ${titleFromRepo(repo.name)} no GitHub`)

    meta.append(stack, link)
    row.append(heading, description, meta)
    grid.appendChild(row)
  }

  fetch('/api/github-projects')
    .then((response) => {
      if (!response.ok) throw new Error('GitHub indisponível')
      return response.json()
    })
    .then((data: { projects?: GithubProject[] }) => {
      ;(data.projects || []).forEach(addDynamicProject)
    })
    .catch(() => {})
</script>
