---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { curatedPublicProjects, privateCases } from '../data/projects'

const githubProfile = 'https://github.com/Pericles-cmyk'
const whatsapp = 'https://wa.me/5581994094491?text=Olá%20PericlesDev!%20Quero%20conversar%20sobre%20um%20projeto.'
const brandLogo = 'https://raw.githubusercontent.com/Pericles-cmyk/Pericles-cmyk/main/assets/brand/periclesdev-header.png'

const solutions = [
  ['01', 'Sistemas de gestão', 'Operação, pedidos, estoque, pagamentos, usuários e relatórios.'],
  ['02', 'Agendamento', 'Plataformas adaptáveis para negócios que trabalham com horários e serviços.'],
  ['03', 'Sites & landing pages', 'Presença digital rápida, responsiva e orientada a conversão.'],
  ['04', 'Aplicações locais', 'Node.js, SQLite, rede LAN, mDNS e instaladores para Windows.'],
]

const process = [
  ['01', 'Entendimento', 'Problema, operação, usuário e objetivo comercial.'],
  ['02', 'UX & fluxo', 'Jornada simples, responsiva e sem etapas desnecessárias.'],
  ['03', 'Desenvolvimento', 'Frontend, backend, APIs e banco de dados.'],
  ['04', 'Infraestrutura', 'Deploy, domínio, rede local e segurança.'],
  ['05', 'Entrega', 'Validação, implantação e evolução da solução.'],
]
---
<BaseLayout>
  <Header />

  <main>
    <section class="hero section" id="inicio">
      <div class="hero-copy">
        <span class="chip">PERICLESDEV • SOFTWARE PARA NEGÓCIOS</span>
        <h1>Planejo. Desenvolvo.<br /><span>Transformo negócios com software.</span></h1>
        <p>Sistemas de gestão, plataformas de agendamento, landing pages e aplicações sob medida — do planejamento à entrega.</p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="#projetos">Ver projetos</a>
          <a class="btn btn--secondary" href="#processo">Como eu trabalho</a>
        </div>
        <div class="trust-line">
          <span>● Projetos reais</span>
          <span>● Código público + cases privados</span>
        </div>
      </div>

      <div class="hero-console" aria-label="Resumo dos projetos da PericlesDev">
        <div class="window-bar"><i></i><i></i><i></i><span>periclesdev.com.br</span></div>
        <div class="console-head"><strong>Projetos em produção</strong><span class="live-dot">● Online</span></div>
        <div class="metrics">
          <div><span>Soluções</span><strong>06</strong></div>
          <div><span>Stack</span><strong>10+</strong></div>
          <div><span>Foco</span><strong>Negócios</strong></div>
        </div>
        <div class="console-list">
          <div><span><strong>Sistema de Gestão</strong><small>Node.js • SQLite</small></span><b>PRIVADO</b></div>
          <div><span><strong>Agendamento</strong><small>Astro • Supabase</small></span><b>CASE</b></div>
          <div><span><strong>Portfólio PericlesDev</strong><small>Astro • Cloudflare</small></span><b>ONLINE</b></div>
        </div>
      </div>
    </section>

    <section class="identity-strip section-narrow" aria-label="Identidade PericlesDev">
      <img src={brandLogo} alt="PericlesDev — Planejo, Desenvolvo, Transformo" width="760" height="180" loading="lazy" />
    </section>

    <section class="section section--alt" id="solucoes">
      <div class="section-heading">
        <span class="eyebrow">SOLUÇÕES</span>
        <h2>Tecnologia pensada para operação real.</h2>
        <p>Da presença digital ao sistema que sustenta a rotina do negócio.</p>
      </div>

      <div class="solution-grid">
        {solutions.map(([number, title, description]) => (
          <article class="solution-card">
            <span class="number-badge">{number}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="projetos">
      <div class="section-heading section-heading--wide">
        <span class="eyebrow">PROJETOS EM DESTAQUE</span>
        <h2>Cases que mostram como necessidades viram produto.</h2>
        <p>Projetos comerciais aparecem como cases visuais. O código permanece privado.</p>
      </div>

      <div class="project-grid project-grid--private">
        {privateCases.map((project) => <ProjectCard project={project} />)}
      </div>

      <div class="public-heading">
        <div>
          <span class="eyebrow">OPEN SOURCE / GITHUB</span>
          <h2>Projetos públicos</h2>
        </div>
        <a class="text-link" href={githubProfile} target="_blank" rel="noreferrer">Abrir GitHub ↗</a>
      </div>

      <div class="automation-note">
        <span>↻</span>
        <p>Novo repositório público + topic <strong>portfolio</strong> = novo projeto automático nesta seção.</p>
      </div>

      <div class="project-grid project-grid--public" data-github-grid>
        {curatedPublicProjects.map((project) => <ProjectCard project={project} />)}
      </div>
      <p class="github-status" data-github-status aria-live="polite"></p>
    </section>

    <section class="section section--alt" id="processo">
      <div class="section-heading section-heading--wide">
        <span class="eyebrow">COMO EU TRABALHO</span>
        <h2>Do problema à entrega, sem perder o contexto do negócio.</h2>
        <p>Produto, UX, desenvolvimento, banco de dados e infraestrutura em uma única linha de execução.</p>
      </div>

      <div class="process-grid">
        {process.map(([number, title, description]) => (
          <article class="process-card">
            <span>{number}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>

      <div class="stack-strip">
        {['Astro', 'TypeScript', 'Node.js', 'Supabase', 'PostgreSQL', 'SQLite', 'Cloudflare', 'GitHub API']
          .map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section class="section about" id="sobre">
      <div class="about-card">
        <div>
          <span class="eyebrow">PERICLESDEV</span>
          <h2>Software com foco em resolver a operação.</h2>
        </div>
        <p>
          Desenvolvo soluções digitais para empresas e profissionais, conectando interface, regras de negócio,
          dados e infraestrutura. A base técnica é enxuta e cada entrega é adaptada ao contexto do cliente.
        </p>
      </div>
    </section>

    <section class="section contact" id="contato">
      <div class="contact-panel">
        <div>
          <span class="eyebrow">VAMOS CONSTRUIR ALGO ÚTIL?</span>
          <h2>Sua próxima solução pode começar por uma conversa.</h2>
          <p>Sistemas, automações, páginas comerciais e aplicações para negócios.</p>
        </div>
        <div class="contact-actions">
          <a class="btn btn--primary" href={whatsapp} target="_blank" rel="noreferrer">Falar no WhatsApp</a>
          <a class="btn btn--secondary" href={githubProfile} target="_blank" rel="noreferrer">Ver GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  interface GithubProject {
    id: number
    name: string
    description: string | null
    html_url: string
    homepage: string | null
    language: string | null
    topics: string[]
  }

  const grid = document.querySelector<HTMLElement>('[data-github-grid]')
  const status = document.querySelector<HTMLElement>('[data-github-status]')

  function titleFromRepo(name: string) {
    return name
      .replace(/[-_]/g, ' ')
      .replace(/\b\w/g, (letter) => letter.toUpperCase())
  }

  function addDynamicCard(repo: GithubProject) {
    if (!grid) return

    const existing = new Set(
      Array.from(grid.querySelectorAll<HTMLElement>('[data-repo-url]'))
        .map((element) => element.dataset.repoUrl)
        .filter(Boolean),
    )
    if (existing.has(repo.html_url)) return

    const article = document.createElement('article')
    article.className = 'project-card'
    article.dataset.repoUrl = repo.html_url

    const visual = document.createElement('a')
    visual.className = 'project-visual'
    visual.href = repo.homepage || repo.html_url
    visual.target = '_blank'
    visual.rel = 'noreferrer'
    visual.setAttribute('aria-label', `Abrir ${titleFromRepo(repo.name)}`)

    const glow = document.createElement('div')
    glow.className = 'project-visual__glow'

    const browser = document.createElement('div')
    browser.className = 'project-browser'
    browser.append(document.createElement('span'), document.createElement('span'), document.createElement('span'))
    const badge = document.createElement('strong')
    badge.textContent = 'PROJETO PÚBLICO'
    browser.appendChild(badge)

    const lines = document.createElement('div')
    lines.className = 'project-mock-lines'
    lines.append(document.createElement('i'), document.createElement('i'), document.createElement('i'), document.createElement('i'))

    const placeholder = document.createElement('span')
    placeholder.className = 'project-placeholder'
    placeholder.textContent = 'Projeto sincronizado do GitHub'
    visual.append(glow, browser, lines, placeholder)

    const head = document.createElement('div')
    head.className = 'project-card__head'
    const headText = document.createElement('div')
    const eyebrow = document.createElement('span')
    eyebrow.className = 'eyebrow'
    eyebrow.textContent = repo.topics.find((topic) => topic !== 'portfolio') || 'OPEN SOURCE'
    const title = document.createElement('h3')
    title.textContent = titleFromRepo(repo.name)
    const subtitle = document.createElement('p')
    subtitle.className = 'project-subtitle'
    subtitle.textContent = 'Projeto público sincronizado do GitHub'
    headText.append(eyebrow, title, subtitle)

    const statusPill = document.createElement('span')
    statusPill.className = 'status-pill status-pill--public'
    statusPill.textContent = 'GitHub'
    head.append(headText, statusPill)

    const description = document.createElement('p')
    description.className = 'project-description'
    description.textContent = repo.description || 'Projeto público desenvolvido pela PericlesDev.'

    const tech = document.createElement('div')
    tech.className = 'tech-list'
    const stack = [repo.language, ...repo.topics.filter((topic) => topic !== 'portfolio').slice(0, 4)].filter(Boolean) as string[]
    stack.forEach((item) => {
      const span = document.createElement('span')
      span.textContent = item
      tech.appendChild(span)
    })

    const actions = document.createElement('div')
    actions.className = 'project-actions'
    if (repo.homepage) {
      const live = document.createElement('a')
      live.className = 'text-link'
      live.href = repo.homepage
      live.target = '_blank'
      live.rel = 'noreferrer'
      live.textContent = 'Ver online ↗'
      actions.appendChild(live)
    }
    const github = document.createElement('a')
    github.className = 'text-link'
    github.href = repo.html_url
    github.target = '_blank'
    github.rel = 'noreferrer'
    github.textContent = 'GitHub ↗'
    actions.appendChild(github)

    article.append(visual, head, description, tech, actions)
    grid.appendChild(article)
  }

  fetch('/api/github-projects')
    .then((response) => {
      if (!response.ok) throw new Error('GitHub indisponível')
      return response.json()
    })
    .then((data: { projects?: GithubProject[] }) => {
      const projects = data.projects || []
      projects.forEach(addDynamicCard)
      if (status) status.textContent = projects.length ? 'Projetos públicos sincronizados.' : ''
    })
    .catch(() => {
      if (status) status.textContent = ''
    })
</script>
