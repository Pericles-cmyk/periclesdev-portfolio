---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { curatedPublicProjects, privateCases } from '../data/projects'

const projects = [...privateCases, ...curatedPublicProjects].sort((a, b) => {
  const aDevelopment = a.status === 'development' ? 1 : 0
  const bDevelopment = b.status === 'development' ? 1 : 0
  return bDevelopment - aDevelopment
})

const githubProfile = 'https://github.com/Pericles-cmyk'
const linkedinProfile = 'https://www.linkedin.com/in/periclesdev/'
const contactEmail = 'carllessonpericles.dev@outlook.com'
const whatsapp = 'https://wa.me/5581994094491?text=Olá%20PericlesDev!%20Quero%20conversar%20sobre%20um%20projeto.'

const capabilities = [
  {
    title: 'Sistemas de gestão',
    description: 'Pedidos, estoque, pagamentos, usuários e relatórios organizados em uma operação mais simples.',
    image: 'https://images.unsplash.com/photo-1771922748624-b205cf5d002d?auto=format&fit=crop&w=1200&q=82',
    alt: 'Notebook e celular exibindo uma interface de gestão',
  },
  {
    title: 'Agendamento',
    description: 'Reservas e horários organizados de forma clara para o cliente e para o negócio.',
    image: 'https://images.unsplash.com/photo-1668608321326-6a82b70558bc?auto=format&fit=crop&w=1200&q=82',
    alt: 'Pessoa planejando atividades em uma mesa de trabalho',
  },
  {
    title: 'Sites e presença digital',
    description: 'Sites e páginas comerciais pensados para apresentar o negócio com clareza e facilitar o contato.',
    image: 'https://images.unsplash.com/photo-1663882658055-40f1d4249867?auto=format&fit=crop&w=1200&q=82',
    alt: 'Notebook e celular em uma mesa de trabalho',
  },
  {
    title: 'Aplicações locais',
    description: 'Sistemas instalados no próprio estabelecimento, preparados para acompanhar a rotina da operação.',
    image: 'https://images.unsplash.com/photo-1535341000823-01aa350a4fbb?auto=format&fit=crop&w=1200&q=82',
    alt: 'Computador em um ambiente de trabalho',
  },
]

const process = [
  { number: '01', title: 'Entender', description: 'Mapeio operação, usuário e objetivo antes de escolher a tecnologia.', icon: '⌕' },
  { number: '02', title: 'Desenhar', description: 'Organizo fluxos e interface para reduzir atrito no uso diário.', icon: '▱' },
  { number: '03', title: 'Construir', description: 'Desenvolvo frontend, backend, dados e integrações necessárias.', icon: '</>' },
  { number: '04', title: 'Implantar', description: 'Configuro ambiente, domínio, infraestrutura e entrega da solução.', icon: '↗' },
]
---
<BaseLayout>
  <Header />

  <main>
    <section class="portfolio-hero" id="inicio">
      <div class="portfolio-hero__copy">
        <span class="portfolio-kicker">PERICLESDEV / DESENVOLVIMENTO DE SOFTWARE</span>
        <h1>Planejo, desenvolvo e transformo <em>necessidades reais</em> em software.</h1>
        <p>
          Sistemas de gestão, plataformas de agendamento e experiências web construídas
          do fluxo de uso à infraestrutura.
        </p>

        <div class="portfolio-hero__actions">
          <a class="btn btn--primary" href="#projetos">Conhecer projetos</a>
          <a class="portfolio-link" href={whatsapp} target="_blank" rel="noreferrer">Falar sobre um projeto ↗</a>
        </div>
      </div>

      <aside class="portfolio-hero__side" aria-label="Perfil profissional e contato">
        <section class="profile-card">
          <div class="profile-card__top">
            <a
              class="profile-card__avatar-link"
              href={githubProfile}
              target="_blank"
              rel="noreferrer"
              data-github-profile-link
              aria-label="Abrir perfil no GitHub"
            >
              <span class="profile-card__avatar-wrap">
                <img
                  class="profile-card__avatar"
                  src="https://github.com/Pericles-cmyk.png?size=320"
                  alt="Foto do perfil de Carllesson Pericles no GitHub"
                  width="176"
                  height="176"
                  data-github-avatar
                />
                <span class="profile-card__status-dot" aria-hidden="true"></span>
              </span>
            </a>

            <div class="profile-card__intro">
              <span class="profile-card__availability">
                <i aria-hidden="true"></i>
                Disponível para novos projetos
              </span>
              <p class="profile-card__bio" data-github-bio hidden></p>
            </div>
          </div>

          <div class="profile-card__rows">
            <div class="profile-card__row">
              <span class="profile-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M20 21a8 8 0 0 0-16 0M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/></svg>
              </span>
              <span class="profile-card__label">Nome completo</span>
              <strong>Carllesson Pericles Da Silva Oliveira</strong>
            </div>

            <div class="profile-card__row">
              <span class="profile-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
              </span>
              <span class="profile-card__label">Cidade</span>
              <strong>Recife, Pernambuco · Brasil</strong>
            </div>

            <div class="profile-card__row">
              <span class="profile-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M3 5h18v14H3z"/><path d="m3 7 9 6 9-6"/></svg>
              </span>
              <span class="profile-card__label">E-mail</span>
              <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            </div>

            <div class="profile-card__row">
              <span class="profile-card__icon profile-card__icon--linkedin" aria-hidden="true">in</span>
              <span class="profile-card__label">LinkedIn</span>
              <a href={linkedinProfile} target="_blank" rel="noreferrer">linkedin.com/in/periclesdev/ ↗</a>
            </div>
          </div>

          <div class="profile-card__actions">
            <a class="btn btn--primary profile-card__button" href={whatsapp} target="_blank" rel="noreferrer">
              Conversar
              <span aria-hidden="true">→</span>
            </a>
            <a class="profile-card__social-link" href={linkedinProfile} target="_blank" rel="noreferrer">
              Ver LinkedIn ↗
            </a>
            <a class="profile-card__social-link" href={githubProfile} target="_blank" rel="noreferrer">
              Ver GitHub ↗
            </a>
          </div>
        </section>
      </aside>
    </section>

    <section class="portfolio-section portfolio-projects" id="projetos">
      <header class="portfolio-section__head">
        <div>
          <h2>Projetos construídos para contextos diferentes.</h2>
        </div>
        <p>
          Cada projeto parte de uma necessidade específica. A interface, a arquitetura e a
          entrega mudam de acordo com o contexto e com quem vai usar a solução.
        </p>
      </header>

      <div class="project-rail-shell">
        <button class="project-rail-button project-rail-button--prev" type="button" aria-label="Projetos anteriores" data-rail-prev>←</button>
        <div class="project-rail" data-project-rail data-github-grid>
          {projects.map((project) => <ProjectCard project={project} />)}
        </div>
        <button class="project-rail-button project-rail-button--next" type="button" aria-label="Próximos projetos" data-rail-next>→</button>
      </div>
    </section>

    <section class="portfolio-section portfolio-capabilities" id="solucoes">
      <header class="portfolio-section__head portfolio-section__head--compact">
        <div>
          <span class="portfolio-kicker">O QUE EU DESENVOLVO</span>
          <h2>Soluções digitais sem complexidade desnecessária.</h2>
        </div>
      </header>

      <div class="capability-grid">
        {capabilities.map((capability) => (
          <article class="capability-card">
            <div class="capability-card__media">
              <img
                src={capability.image}
                alt={capability.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="capability-card__content">
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="portfolio-section portfolio-process" id="processo">
      <header class="portfolio-section__head portfolio-section__head--compact">
        <div>
          <span class="portfolio-kicker">PROCESSO</span>
          <h2>Do problema à implantação.</h2>
        </div>
      </header>

      <div class="process-list">
        {process.map((step) => (
          <article class="process-item">
            <div class="process-item__visual" aria-hidden="true">
              <span>{step.icon}</span>
              <i></i><i></i><i></i>
            </div>
            <span class="process-item__number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))}
      </div>

      <div class="stack-line" aria-label="Tecnologias">
        {['Astro', 'TypeScript', 'React', 'Node.js', 'Supabase', 'PostgreSQL', 'SQLite', 'Cloudflare']
          .map((item) => <span>{item}</span>)}
      </div>
    </section>

    <section class="portfolio-section portfolio-about" id="sobre">
      <span class="portfolio-kicker">PERICLESDEV</span>
      <div class="portfolio-about__grid">
        <h2>Tecnologia aplicada ao que o negócio realmente precisa.</h2>
        <div>
          <p>
            Trabalho conectando interface, regras de negócio, dados e infraestrutura para
            transformar processos em produtos digitais utilizáveis no dia a dia.
          </p>
          <p>
            A tecnologia entra como ferramenta. A prioridade é uma solução clara,
            sustentável e adequada ao contexto de quem vai usar.
          </p>
        </div>
      </div>
    </section>

    <section class="portfolio-section portfolio-contact" id="contato">
      <div>
        <span class="portfolio-kicker">NOVO PROJETO</span>
        <h2>Tem uma operação que pode funcionar melhor?</h2>
        <p>Podemos conversar sobre o problema antes de falar em tecnologia.</p>
      </div>
      <a class="btn btn--primary" href={whatsapp} target="_blank" rel="noreferrer">Conversar no WhatsApp</a>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  interface GithubProject {
    id: number
    name: string
    description: string | null
    html_url: string
    homepage: string | null
    language: string | null
    topics: string[]
  }

  const grid = document.querySelector<HTMLElement>('[data-github-grid]')

  function titleFromRepo(name: string) {
    return name
      .replace(/[-_]/g, ' ')
      .replace(/\b\w/g, (letter) => letter.toUpperCase())
  }

  const techMarks: Record<string, string> = {
    Astro: 'A',
    TypeScript: 'TS',
    React: '⚛',
    Vite: 'V',
    'Node.js': 'JS',
    Express: 'EX',
    SQLite: 'DB',
    'Socket.IO': 'IO',
    HTML: '5',
    CSS: '3',
    JavaScript: 'JS',
    Supabase: 'S',
    PostgreSQL: 'PG',
    Realtime: 'RT',
    Docker: 'D',
    Python: 'Py',
    Cloudflare: 'CF',
  }

  const techIcons: Record<string, string> = {
    Astro: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg',
    TypeScript: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg',
    React: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg',
    Vite: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vitejs/vitejs-original.svg',
    'Node.js': 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg',
    SQLite: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/sqlite/sqlite-original.svg',
    HTML: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg',
    CSS: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg',
    JavaScript: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg',
    Supabase: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/supabase/supabase-original.svg',
    PostgreSQL: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg',
    Docker: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg',
    Python: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg',
    Cloudflare: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/cloudflare/cloudflare-original.svg',
  }

  function techKey(tech: string) {
    return tech.toLowerCase().replace(/[^a-z0-9]+/g, '-')
  }

  function createAction(label: string, href: string, primary = false) {
    const link = document.createElement('a')
    link.className = primary
      ? 'project-action project-action--primary'
      : 'project-action project-action--secondary'
    link.href = href
    link.target = '_blank'
    link.rel = 'noreferrer'

    const icon = document.createElement('span')
    icon.setAttribute('aria-hidden', 'true')
    icon.textContent = primary ? '↗' : '⌘'

    link.append(icon, document.createTextNode(label))
    return link
  }

  function addDynamicProject(repo: GithubProject) {
    if (!grid) return

    const existing = new Set(
      Array.from(document.querySelectorAll<HTMLElement>('[data-repo-url]'))
        .map((element) => element.dataset.repoUrl)
        .filter(Boolean),
    )

    if (existing.has(repo.html_url)) return

    const article = document.createElement('article')
    article.className = 'project-card'
    article.dataset.repoUrl = repo.html_url

    const visual = document.createElement('a')
    visual.className = 'project-visual'
    visual.href = repo.homepage || repo.html_url
    visual.target = '_blank'
    visual.rel = 'noreferrer'
    visual.setAttribute('aria-label', `Abrir ${titleFromRepo(repo.name)}`)

    const glow = document.createElement('div')
    glow.className = 'project-visual__glow'

    const browser = document.createElement('div')
    browser.className = 'project-browser'
    browser.append(document.createElement('span'), document.createElement('span'), document.createElement('span'))

    const lines = document.createElement('div')
    lines.className = 'project-mock-lines'
    lines.append(document.createElement('i'), document.createElement('i'), document.createElement('i'), document.createElement('i'))

    visual.append(glow, browser, lines)

    const content = document.createElement('div')
    content.className = 'project-card__content'

    const titleRow = document.createElement('div')
    titleRow.className = 'project-card__title-row'

    const titleGroup = document.createElement('div')
    const category = document.createElement('span')
    category.className = 'eyebrow'
    category.textContent = repo.topics.find((topic) => topic !== 'portfolio') || 'Projeto'

    const title = document.createElement('h3')
    title.textContent = titleFromRepo(repo.name)
    titleGroup.append(category, title)

    const status = document.createElement('span')
    status.className = 'project-status project-status--public'
    const statusDot = document.createElement('i')
    statusDot.setAttribute('aria-hidden', 'true')
    status.append(statusDot, document.createTextNode('Projeto'))

    titleRow.append(titleGroup, status)

    const description = document.createElement('p')
    description.className = 'project-description'
    description.textContent = repo.description || 'Projeto desenvolvido como parte da minha evolução profissional.'

    const projectTech = document.createElement('div')
    projectTech.className = 'project-tech'

    const techHeading = document.createElement('span')
    techHeading.className = 'project-tech__label'
    techHeading.innerHTML = '<span aria-hidden="true">&lt;/&gt;</span> TECNOLOGIAS'

    const tech = document.createElement('div')
    tech.className = 'tech-list tech-list--branded'

    const technologies = [
      repo.language,
      ...repo.topics.filter((topic) => topic !== 'portfolio').slice(0, 4),
    ].filter(Boolean) as string[]

    technologies.forEach((item) => {
      const chip = document.createElement('span')
      chip.className = 'tech-chip'
      chip.dataset.tech = techKey(item)

      const iconUrl = techIcons[item]
      if (iconUrl) {
        const icon = document.createElement('img')
        icon.className = 'tech-chip__icon'
        icon.src = iconUrl
        icon.alt = ''
        icon.loading = 'lazy'
        icon.decoding = 'async'
        chip.appendChild(icon)
      } else {
        const icon = document.createElement('b')
        icon.setAttribute('aria-hidden', 'true')
        icon.textContent = techMarks[item] || '•'
        chip.appendChild(icon)
      }

      const label = document.createElement('span')
      label.textContent = item
      chip.appendChild(label)
      tech.appendChild(chip)
    })

    projectTech.append(techHeading, tech)

    const actions = document.createElement('div')
    actions.className = 'project-actions'

    const primaryUrl = repo.homepage || repo.html_url
    actions.appendChild(createAction('Ver projeto', primaryUrl, true))

    if (repo.homepage) {
      actions.appendChild(createAction('Ver código', repo.html_url))
    }

    content.append(titleRow, description, projectTech, actions)
    article.append(visual, content)
    grid.appendChild(article)
  }

  document.querySelectorAll<HTMLElement>('.project-rail-shell').forEach((shell) => {
    const rail = shell.querySelector<HTMLElement>('[data-project-rail]')
    const previous = shell.querySelector<HTMLButtonElement>('[data-rail-prev]')
    const next = shell.querySelector<HTMLButtonElement>('[data-rail-next]')

    if (!rail) return

    const cards = () => Array.from(rail.querySelectorAll<HTMLElement>('.project-card'))
    let activeIndex = 0
    let wheelLocked = false

    const visibleCount = () => {
      if (window.matchMedia('(max-width: 980px)').matches) return 1
      return 2
    }

    const maxIndex = () => Math.max(cards().length - visibleCount(), 0)

    const cardPositions = () => {
      const railRect = rail.getBoundingClientRect()
      return cards().map((card) => {
        const rect = card.getBoundingClientRect()
        return rect.left - railRect.left + rail.scrollLeft
      })
    }

    const nearestIndex = () => {
      const positions = cardPositions()
      if (!positions.length) return 0

      let nearest = 0
      let distance = Number.POSITIVE_INFINITY

      positions.forEach((position, index) => {
        if (index > maxIndex()) return

        const currentDistance = Math.abs(position - rail.scrollLeft)
        if (currentDistance < distance) {
          distance = currentDistance
          nearest = index
        }
      })

      return nearest
    }

    const updateControls = () => {
      const canNavigate = cards().length > visibleCount()

      shell.classList.toggle('project-rail-shell--scrollable', canNavigate)

      if (previous) previous.disabled = !canNavigate || activeIndex <= 0
      if (next) next.disabled = !canNavigate || activeIndex >= maxIndex()
    }

    const scrollToIndex = (index: number, behavior: ScrollBehavior = 'smooth') => {
      const positions = cardPositions()
      if (!positions.length) return

      activeIndex = Math.max(0, Math.min(index, maxIndex()))

      rail.scrollTo({
        left: positions[activeIndex] ?? 0,
        behavior,
      })

      updateControls()
    }

    const move = (direction: number) => {
      scrollToIndex(activeIndex + direction)
    }

    previous?.addEventListener('click', () => move(-1))
    next?.addEventListener('click', () => move(1))

    rail.addEventListener(
      'wheel',
      (event) => {
        const horizontalIntent =
          Math.abs(event.deltaX) > Math.abs(event.deltaY) || event.shiftKey

        if (!horizontalIntent || cards().length <= visibleCount()) return

        event.preventDefault()
        if (wheelLocked) return

        const delta = event.deltaX || event.deltaY
        move(delta > 0 ? 1 : -1)

        wheelLocked = true
        window.setTimeout(() => {
          wheelLocked = false
        }, 420)
      },
      { passive: false },
    )

    let scrollIdle = 0

    rail.addEventListener('scroll', () => {
      window.clearTimeout(scrollIdle)

      scrollIdle = window.setTimeout(() => {
        activeIndex = nearestIndex()
        scrollToIndex(activeIndex)
      }, 120)
    })

    const refreshRail = () => {
      rail.style.paddingRight = '0px'
      activeIndex = Math.min(activeIndex, maxIndex())
      scrollToIndex(activeIndex, 'auto')
      updateControls()
    }

    const observer = new MutationObserver(refreshRail)
    observer.observe(rail, { childList: true })

    window.addEventListener('resize', refreshRail)
    requestAnimationFrame(refreshRail)
  })

  fetch('/api/github-projects')
    .then((response) => {
      if (!response.ok) throw new Error('Projetos indisponíveis')
      return response.json()
    })
    .then((data: { projects?: GithubProject[] }) => {
      ;(data.projects || []).forEach(addDynamicProject)
    })
    .catch(() => {})
</script>
