---
import type { PortfolioProject } from '../data/projects'

interface Props {
  project: PortfolioProject
}

const { project } = Astro.props
---
<article class="public-featured" data-repo-url={project.repoUrl || ''}>
  <div class="public-featured__content">
    <span class="public-featured__badge">PROJETO ACADÊMICO</span>

    <div>
      <h3>{project.title}</h3>
      <p>{project.description}</p>
    </div>

    <div class="public-featured__stack">
      {project.stack.map((tech) => <span>{tech}</span>)}
    </div>

    <div class="public-featured__actions">
      {project.liveUrl && (
        <a href={project.liveUrl} target="_blank" rel="noreferrer">Abrir projeto ↗</a>
      )}
      {project.repoUrl && (
        <a href={project.repoUrl} target="_blank" rel="noreferrer">Ver no GitHub ↗</a>
      )}
    </div>
  </div>

  <a
    class="parking-preview"
    href={project.liveUrl || project.repoUrl}
    target="_blank"
    rel="noreferrer"
    aria-label="Abrir Sistema de Estacionamento UniCesumar"
  >
    <div class="parking-preview__window">
      <div class="parking-preview__top">
        <div>
          <strong>UniCesumar Parking</strong>
          <span>painel de estacionamento</span>
        </div>
        <small>● Aberto</small>
      </div>

      <div class="parking-preview__metrics" aria-hidden="true">
        <div>
          <span>No pátio</span>
          <strong>12</strong>
        </div>
        <div>
          <span>Saídas</span>
          <strong>08</strong>
        </div>
        <div>
          <span>Isentos</span>
          <strong>03</strong>
        </div>
        <div>
          <span>Receita</span>
          <strong>R$ 42,50</strong>
        </div>
      </div>

      <div class="parking-preview__body" aria-hidden="true">
        <div class="parking-preview__panel">
          <div class="parking-preview__panel-title">
            <span>Entrada / saída</span>
            <b>PLACA</b>
          </div>
          <div class="parking-preview__input">ABC1D23</div>
          <div class="parking-preview__buttons">
            <span>Registrar entrada</span>
            <span>Registrar saída</span>
          </div>
        </div>

        <div class="parking-preview__panel parking-preview__panel--chart">
          <div class="parking-preview__panel-title">
            <span>Distribuição</span>
            <b>TIPOS</b>
          </div>
          <div class="parking-preview__bars">
            <i style="--h:58%"></i>
            <i style="--h:84%"></i>
            <i style="--h:42%"></i>
          </div>
          <div class="parking-preview__legend">
            <span>Moto</span><span>Carro</span><span>Camionete</span>
          </div>
        </div>
      </div>

      <div class="parking-preview__history" aria-hidden="true">
        <span>Histórico de saídas do dia</span>
        <div><b>QWE4R56</b><small>09:18 → 11:42</small><strong>R$ 3,50</strong></div>
        <div><b>ABC1D23</b><small>10:05 → 10:14</small><strong>Isento</strong></div>
      </div>
    </div>
  </a>
</article>
