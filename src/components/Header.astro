---
const whatsapp = 'https://wa.me/5581994094491?text=Olá%20PericlesDev!%20Quero%20conversar%20sobre%20um%20projeto.'
const githubAvatar = 'https://github.com/Pericles-cmyk.png?size=96'
---
<header class="nav-shell">
  <a class="brand" href="/#inicio" aria-label="PericlesDev - início">
    <img
      class="brand-avatar"
      src={githubAvatar}
      alt=""
      width="34"
      height="34"
      data-github-avatar
    />
    <span>PericlesDev</span>
  </a>

  <button class="menu-button" type="button" aria-label="Abrir menu" aria-expanded="false">☰</button>

  <nav class="nav-links" aria-label="Navegação principal">
    <a href="/#projetos">Projetos</a>
    <a href="/#solucoes">Atuação</a>
    <a href="/#processo">Processo</a>
    <a href="/#sobre">Sobre</a>
    <a class="btn btn--primary nav-cta" href={whatsapp} target="_blank" rel="noreferrer">Conversar</a>
  </nav>
</header>

<script>
  interface GithubProfile {
    login?: string
    name?: string | null
    bio?: string | null
    avatar_url?: string | null
    html_url?: string | null
  }

  const button = document.querySelector<HTMLButtonElement>('.menu-button')
  const nav = document.querySelector<HTMLElement>('.nav-links')

  button?.addEventListener('click', () => {
    const open = nav?.classList.toggle('nav-links--open') ?? false
    button.setAttribute('aria-expanded', String(open))
  })

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      nav.classList.remove('nav-links--open')
      button?.setAttribute('aria-expanded', 'false')
    })
  })

  fetch('/api/github-profile')
    .then((response) => {
      if (!response.ok) throw new Error('Perfil indisponível')
      return response.json()
    })
    .then((data: { profile?: GithubProfile }) => {
      const profile = data.profile
      if (!profile) return

      if (profile.avatar_url) {
        document.querySelectorAll<HTMLImageElement>('[data-github-avatar]').forEach((image) => {
          image.src = profile.avatar_url!
        })
      }

      document.querySelectorAll<HTMLElement>('[data-github-name]').forEach((element) => {
        element.textContent = profile.name || profile.login || 'PericlesDev'
      })

      document.querySelectorAll<HTMLElement>('[data-github-login]').forEach((element) => {
        element.textContent = profile.login ? `@${profile.login}` : '@Pericles-cmyk'
      })

      document.querySelectorAll<HTMLElement>('[data-github-bio]').forEach((element) => {
        if (profile.bio) {
          element.textContent = profile.bio
          element.hidden = false
        } else {
          element.hidden = true
        }
      })

      document.querySelectorAll<HTMLAnchorElement>('[data-github-profile-link]').forEach((link) => {
        if (profile.html_url) link.href = profile.html_url
      })
    })
    .catch(() => {})
</script>
