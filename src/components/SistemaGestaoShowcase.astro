---
const screens = [
  {
    src: '/projects/sistema-gestao/login.webp',
    title: 'Login e acesso local',
    description: 'Acesso ao sistema e endereço local para celulares e outros dispositivos conectados à rede.',
  },
  {
    src: '/projects/sistema-gestao/cardapio.webp',
    title: 'Cardápio',
    description: 'Produtos, categorias, preços, estoque e disponibilidade em uma visão administrativa.',
  },
  {
    src: '/projects/sistema-gestao/estoque.webp',
    title: 'Estoque',
    description: 'Consulta e ajuste rápido de quantidades, com destaque para itens com estoque baixo.',
  },
  {
    src: '/projects/sistema-gestao/pedido.webp',
    title: 'Gerência da mesa',
    description: 'Seleção de produtos e acompanhamento da comanda durante o atendimento.',
  },
  {
    src: '/projects/sistema-gestao/pagamento.webp',
    title: 'Pagamento',
    description: 'Fluxo de fechamento com PIX, dinheiro, crédito e débito, incluindo pagamento misto.',
  },
  {
    src: '/projects/sistema-gestao/historico.webp',
    title: 'Histórico',
    description: 'Consulta do movimento por data ou período e geração de relatórios.',
  },
]

const highlights = [
  ['01', 'Operação local', 'Funciona dentro do próprio estabelecimento e pode ser acessado pelos dispositivos conectados à mesma rede.'],
  ['02', 'Administração', 'Cardápio, estoque, mesas, usuários, histórico e configurações ficam concentrados no painel administrativo.'],
  ['03', 'Atendimento', 'Mesas e pedidos de balcão compartilham o mesmo fluxo operacional, com atualização durante o atendimento.'],
  ['04', 'Instalação simplificada', 'O sistema é entregue com instalador próprio para Windows e preparado para uso no ambiente do cliente.'],
]
---
<section class="management-case" aria-label="Sistema de Gestão">
  <div class="management-case__hero">
    <div class="management-case__intro">
      <span class="portfolio-kicker">VISÃO DO PRODUTO</span>
      <h2>Uma base de gestão preparada para diferentes operações.</h2>
      <p>
        O sistema concentra atendimento, pedidos, estoque, pagamentos e administração
        em uma única experiência, com configuração adaptável ao estabelecimento.
      </p>
    </div>

    <figure class="management-case__main-shot">
      <img
        src="/projects/sistema-gestao/atendimentos.webp"
        alt="Tela atual de atendimentos do Sistema de Gestão"
        loading="eager"
        decoding="async"
      />
      <figcaption>
        <span>Atendimentos</span>
        <strong>Mesas e pedidos de balcão</strong>
      </figcaption>
    </figure>
  </div>

  <div class="management-highlights">
    {highlights.map(([number, title, description]) => (
      <article>
        <span>{number}</span>
        <h3>{title}</h3>
        <p>{description}</p>
      </article>
    ))}
  </div>

  <div class="management-gallery">
    {screens.map((screen) => (
      <figure class="management-gallery__item">
        <div>
          <img
            src={screen.src}
            alt={screen.title}
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>
          <h3>{screen.title}</h3>
          <p>{screen.description}</p>
        </figcaption>
      </figure>
    ))}
  </div>

  <section class="management-case__closing">
    <span class="portfolio-kicker">EXPERIÊNCIA COMPLETA</span>
    <h2>Do atendimento à administração.</h2>
    <p>
      A proposta é manter a operação simples para quem atende e, ao mesmo tempo,
      oferecer ao responsável pelo estabelecimento controle sobre produtos, estoque,
      usuários, pagamentos, histórico, impressão e configurações.
    </p>
  </section>
</section>
