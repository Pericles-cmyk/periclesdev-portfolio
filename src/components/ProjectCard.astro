---
import type { PortfolioProject } from '../data/projects'

interface Props {
  project: PortfolioProject
}

const { project } = Astro.props
const detailUrl = project.kind === 'private' ? `/projetos/${project.slug}` : undefined
const isLarissa = project.slug === 'larissa-souza'
const isJazi = project.slug === 'studio-jazi-lino'
const isParking = project.slug === 'unicesumar-parking'
const isManagement = project.slug === 'sistema-de-gestao'
const statusLabel = project.kind === 'public' ? 'Projeto público' : project.liveUrl ? 'Online' : 'Case'
const primaryUrl = detailUrl || project.liveUrl || project.repoUrl || '#'
const primaryExternal = !detailUrl
---
<article
  class:list={[
    'project-card',
    {
      'project-card--larissa': isLarissa,
      'project-card--jazi': isJazi,
      'project-card--parking': isParking,
      'project-card--management': isManagement,
    },
  ]}
  data-repo-url={project.repoUrl || ''}
>
  <a
    class:list={[
      'project-visual',
      {
        'project-visual--larissa': isLarissa,
        'project-visual--jazi': isJazi,
        'project-visual--parking': isParking,
        'project-visual--management': isManagement,
      },
    ]}
    href={primaryUrl}
    target={primaryExternal ? '_blank' : undefined}
    rel={primaryExternal ? 'noreferrer' : undefined}
    aria-label={`Abrir ${project.title}`}
  >
    {isManagement ? (
      <div class="management-preview">
        <img src="/projects/sistema-gestao/atendimentos.webp" alt="" loading="lazy" decoding="async" />
        <div class="management-preview__overlay">
          <span>Sistema de Gestão</span>
          <strong>Operação centralizada</strong>
        </div>
      </div>
    ) : isLarissa ? (
      <div class="larissa-preview">
        <div class="larissa-preview__top">
          <span class="larissa-preview__brand">Larissa Souza<small>SOBRANCELHAS BP</small></span>
          <span class="larissa-preview__nav">Serviços · Agendar · Consultar</span>
        </div>
        <div class="larissa-preview__body">
          <div>
            <small>BELEZA • PRECISÃO • AUTOESTIMA</small>
            <strong>Seu olhar merece um cuidado <em>especial.</em></strong>
            <span>Agendamento online</span>
          </div>
          <div class="larissa-preview__profile">
            <span>LS</span>
            <b>Larissa Souza ✓</b>
          </div>
        </div>
      </div>
    ) : isJazi ? (
      <div class="jazi-preview">
        <div class="jazi-preview__nav">
          <span>Sobre</span>
          <strong>JAZI LINO</strong>
          <span>Serviços · Contato</span>
        </div>
        <div class="jazi-preview__hero">
          <div>
            <small>JAZI LINO BEAUTY STUDIO</small>
            <strong>Realce a sua beleza com um atendimento feito para você.</strong>
            <span>Conhecer serviços</span>
          </div>
          <div class="jazi-preview__logo">
            <b>JL</b>
            <small>BEAUTY STUDIO</small>
          </div>
        </div>
      </div>
    ) : isParking ? (
      <div class="parking-card-preview">
        <div class="parking-card-preview__top">
          <div>
            <strong>UniCesumar Parking</strong>
            <small>Painel de estacionamento</small>
          </div>
          <span>● Aberto</span>
        </div>
        <div class="parking-card-preview__metrics">
          <div><small>No pátio</small><strong>12</strong></div>
          <div><small>Saídas</small><strong>08</strong></div>
          <div><small>Isentos</small><strong>03</strong></div>
          <div><small>Receita</small><strong>R$ 42</strong></div>
        </div>
        <div class="parking-card-preview__content">
          <div class="parking-card-preview__form">
            <small>Entrada / saída</small>
            <span>ABC1D23</span>
            <div><b>Entrada</b><b>Saída</b></div>
          </div>
          <div class="parking-card-preview__chart">
            <i style="--h:48%"></i><i style="--h:82%"></i><i style="--h:62%"></i>
          </div>
        </div>
      </div>
    ) : (
      <>
        <div class="project-visual__glow"></div>
        <div class="project-browser"><span></span><span></span><span></span></div>
        <div class="project-mock-lines"><i></i><i></i><i></i><i></i></div>
      </>
    )}
  </a>

  <div class="project-card__content">
    <div class="project-card__title-row">
      <div>
        <span class="eyebrow">{project.category}</span>
        <h3>{project.title}</h3>
      </div>
      <span class:list={['project-status', { 'project-status--public': project.kind === 'public' }]}>
        <i aria-hidden="true"></i>{statusLabel}
      </span>
    </div>

    <p class="project-description">{project.description}</p>

    <div class="tech-list">
      {project.stack.slice(0, 5).map((tech) => <span>{tech}</span>)}
    </div>

    <div class="project-actions">
      <a
        class="project-action project-action--primary"
        href={primaryUrl}
        target={primaryExternal ? '_blank' : undefined}
        rel={primaryExternal ? 'noreferrer' : undefined}
      >
        <span aria-hidden="true">↗</span>
        Ver projeto
      </a>

      {project.kind === 'private' && project.liveUrl && (
        <a class="project-action project-action--secondary" href={project.liveUrl} target="_blank" rel="noreferrer">
          <span aria-hidden="true">◎</span>
          Visitar
        </a>
      )}

      {project.kind === 'public' && project.liveUrl && project.repoUrl && (
        <a class="project-action project-action--secondary" href={project.repoUrl} target="_blank" rel="noreferrer">
          <span aria-hidden="true">⌘</span>
          Ver código
        </a>
      )}
    </div>
  </div>
</article>
