---
import type { PortfolioProject } from '../data/projects'

interface Props {
  project: PortfolioProject
}

const { project } = Astro.props
const detailUrl = project.kind === 'private' ? `/projetos/${project.slug}` : undefined
const isLarissa = project.slug === 'larissa-souza'
const isJazi = project.slug === 'studio-jazi-lino'
const isParking = project.slug === 'unicesumar-parking'
const isManagement = project.slug === 'sistema-de-gestao'
const isKeyDeck = project.slug === 'keydeck'
const isDevelopment = project.status === 'development'
const statusLabel = isDevelopment
  ? 'Em desenvolvimento'
  : project.liveUrl
    ? 'Online'
    : 'Projeto'
const primaryUrl = detailUrl || project.liveUrl || project.repoUrl || '#'
const primaryExternal = !detailUrl

const techMarks: Record<string, string> = {
  Astro: 'A',
  TypeScript: 'TS',
  React: '⚛',
  Vite: 'V',
  'Node.js': 'JS',
  Express: 'EX',
  SQLite: 'DB',
  'Socket.IO': 'IO',
  HTML: '5',
  CSS: '3',
  JavaScript: 'JS',
  Supabase: 'S',
  PostgreSQL: 'PG',
  Realtime: 'RT',
  Docker: 'D',
  Python: 'Py',
  Cloudflare: 'CF',
}

const techIcons: Record<string, string> = {
  Astro: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/astro/astro-original.svg',
  TypeScript: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg',
  React: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/react/react-original.svg',
  Vite: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/vitejs/vitejs-original.svg',
  'Node.js': 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/nodejs/nodejs-original.svg',
  SQLite: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/sqlite/sqlite-original.svg',
  HTML: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/html5/html5-original.svg',
  CSS: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/css3/css3-original.svg',
  JavaScript: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/javascript/javascript-original.svg',
  Supabase: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/supabase/supabase-original.svg',
  PostgreSQL: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/postgresql/postgresql-original.svg',
  Docker: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/docker/docker-original.svg',
  Python: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg',
  Cloudflare: 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/cloudflare/cloudflare-original.svg',
}

const techKey = (tech: string) =>
  tech.toLowerCase().replace(/[^a-z0-9]+/g, '-')
---
<article
  class:list={[
    'project-card',
    {
      'project-card--larissa': isLarissa,
      'project-card--jazi': isJazi,
      'project-card--parking': isParking,
      'project-card--management': isManagement,
      'project-card--keydeck': isKeyDeck,
      'project-card--development': isDevelopment,
    },
  ]}
  data-repo-url={project.repoUrl || ''}
>
  <a
    class:list={[
      'project-visual',
      {
        'project-visual--larissa': isLarissa,
        'project-visual--jazi': isJazi,
        'project-visual--parking': isParking,
        'project-visual--management': isManagement,
        'project-visual--keydeck': isKeyDeck,
      },
    ]}
    href={primaryUrl}
    target={primaryExternal ? '_blank' : undefined}
    rel={primaryExternal ? 'noreferrer' : undefined}
    aria-label={`Abrir ${project.title}`}
  >
    {isManagement ? (
      <div class="management-preview management-preview--logo">
        <img
          src="/projects/sistema-gestao/logo.svg"
          alt="Logo do Sistema de Gestão"
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : isKeyDeck ? (
      <div class="keydeck-preview">
        <img
          src="/projects/keydeck/logo.webp"
          alt="Logo KeyDeck"
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : isLarissa ? (
      <div class="larissa-preview">
        <div class="larissa-preview__top">
          <span class="larissa-preview__brand">Larissa Souza<small>SOBRANCELHAS BP</small></span>
          <span class="larissa-preview__nav">Serviços · Agendar · Consultar</span>
        </div>
        <div class="larissa-preview__body">
          <div>
            <small>BELEZA • PRECISÃO • AUTOESTIMA</small>
            <strong>Seu olhar merece um cuidado <em>especial.</em></strong>
            <span>Agendamento online</span>
          </div>
          <div class="larissa-preview__profile">
            <span>LS</span>
            <b>Larissa Souza ✓</b>
          </div>
        </div>
      </div>
    ) : isJazi ? (
      <div class="jazi-preview">
        <div class="jazi-preview__nav">
          <span>Sobre</span>
          <strong>JAZI LINO</strong>
          <span>Serviços · Contato</span>
        </div>
        <div class="jazi-preview__hero">
          <div>
            <small>JAZI LINO BEAUTY STUDIO</small>
            <strong>Realce a sua beleza com um atendimento feito para você.</strong>
            <span>Conhecer serviços</span>
          </div>
          <div class="jazi-preview__logo">
            <b>JL</b>
            <small>BEAUTY STUDIO</small>
          </div>
        </div>
      </div>
    ) : isParking ? (
      <div class="parking-card-preview">
        <div class="parking-card-preview__top">
          <div>
            <strong>UniCesumar Parking</strong>
            <small>Painel de estacionamento</small>
          </div>
          <span>● Aberto</span>
        </div>
        <div class="parking-card-preview__metrics">
          <div><small>No pátio</small><strong>12</strong></div>
          <div><small>Saídas</small><strong>08</strong></div>
          <div><small>Isentos</small><strong>03</strong></div>
          <div><small>Receita</small><strong>R$ 42</strong></div>
        </div>
        <div class="parking-card-preview__content">
          <div class="parking-card-preview__form">
            <small>Entrada / saída</small>
            <span>ABC1D23</span>
            <div><b>Entrada</b><b>Saída</b></div>
          </div>
          <div class="parking-card-preview__chart">
            <i style="--h:48%"></i><i style="--h:82%"></i><i style="--h:62%"></i>
          </div>
        </div>
      </div>
    ) : (
      <>
        <div class="project-visual__glow"></div>
        <div class="project-browser"><span></span><span></span><span></span></div>
        <div class="project-mock-lines"><i></i><i></i><i></i><i></i></div>
      </>
    )}
  </a>

  <div class="project-card__content">
    <div class="project-card__title-row">
      <div>
        <span class="eyebrow">{project.category}</span>
        <h3>{project.title}</h3>
      </div>
      <span class:list={[
        'project-status',
        {
          'project-status--development': isDevelopment,
        },
      ]}>
        <i aria-hidden="true"></i>{statusLabel}
      </span>
    </div>

    <p class="project-description">{project.description}</p>

    <div class="project-tech">
      <span class="project-tech__label"><span aria-hidden="true">&lt;/&gt;</span> TECNOLOGIAS</span>
      <div class="tech-list tech-list--branded" aria-label="Tecnologias utilizadas">
        {project.stack.slice(0, 5).map((tech) => (
          <span class="tech-chip" data-tech={techKey(tech)}>
            {techIcons[tech] ? (
              <img class="tech-chip__icon" src={techIcons[tech]} alt="" loading="lazy" decoding="async" />
            ) : (
              <b aria-hidden="true">{techMarks[tech] || '•'}</b>
            )}
            <span>{tech}</span>
          </span>
        ))}
      </div>
    </div>

    {!project.hideActions && (
      <div class="project-actions">
        <a
          class="project-action project-action--primary"
          href={primaryUrl}
          target={primaryExternal ? '_blank' : undefined}
          rel={primaryExternal ? 'noreferrer' : undefined}
        >
          <span aria-hidden="true">↗</span>
          Ver projeto
        </a>

        {project.kind === 'private' && project.liveUrl && (
          <a class="project-action project-action--secondary" href={project.liveUrl} target="_blank" rel="noreferrer">
            <span aria-hidden="true">◎</span>
            Visitar
          </a>
        )}

        {project.kind === 'public' && project.liveUrl && project.repoUrl && (
          <a class="project-action project-action--secondary" href={project.repoUrl} target="_blank" rel="noreferrer">
            <span aria-hidden="true">⌘</span>
            Ver código
          </a>
        )}
      </div>
    )}
  </div>
</article>
